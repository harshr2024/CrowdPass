{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseOnlyNotificationQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueUrl",
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage"
      ],
      "Resource": "arn:aws:sqs:us-west-2:__ACCOUNT_ID__:crowdpass-temporary-demo-notifications"
    },
    {
      "Sid": "TemporaryEcsExecChannels",
      "Effect": "Allow",
      "Action": [
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": "*"
    }
  ]
}
