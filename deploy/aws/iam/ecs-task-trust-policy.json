{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "ecs-tasks.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnLike": {
          "aws:SourceArn": "arn:aws:ecs:us-west-2:__ACCOUNT_ID__:*"
        },
        "StringEquals": {
          "aws:SourceAccount": "__ACCOUNT_ID__"
        }
      }
    }
  ]
}
