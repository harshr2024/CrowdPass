{
  "family": "crowdpass-temporary-demo",
  "taskRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/crowdpass-temporary-demo-task",
  "executionRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/crowdpass-temporary-demo-execution",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "2048",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "ARM64"
  },
  "containerDefinitions": [
    {
      "name": "crowdpass-api",
      "image": "__ACCOUNT_ID__.dkr.ecr.us-west-2.amazonaws.com/crowdpass-api:__IMAGE_TAG__",
      "essential": true,
      "cpu": 384,
      "memory": 1792,
      "user": "10001:10001",
      "readonlyRootFilesystem": false,
      "privileged": false,
      "linuxParameters": {
        "capabilities": {
          "drop": [
            "ALL"
          ]
        },
        "initProcessEnabled": true
      },
      "environment": [
        {
          "name": "DB_URL",
          "value": "jdbc:postgresql://__RDS_ENDPOINT__:5432/crowdpass"
        },
        {
          "name": "REDIS_HOST",
          "value": "127.0.0.1"
        },
        {
          "name": "REDIS_PORT",
          "value": "6379"
        },
        {
          "name": "CROWDPASS_SQS_REGION",
          "value": "us-west-2"
        },
        {
          "name": "CROWDPASS_SQS_QUEUE",
          "value": "crowdpass-temporary-demo-notifications"
        },
        {
          "name": "CROWDPASS_MESSAGING_PUBLISHER_ENABLED",
          "value": "true"
        },
        {
          "name": "CROWDPASS_MESSAGING_CONSUMER_ENABLED",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:ssm:us-west-2:__ACCOUNT_ID__:parameter/crowdpass/temporary-demo/db/username"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-west-2:__ACCOUNT_ID__:parameter/crowdpass/temporary-demo/db/password"
        },
        {
          "name": "CROWDPASS_JWT_SECRET",
          "valueFrom": "arn:aws:ssm:us-west-2:__ACCOUNT_ID__:parameter/crowdpass/temporary-demo/jwt-secret"
        },
        {
          "name": "CROWDPASS_RATE_LIMIT_SECRET",
          "valueFrom": "arn:aws:ssm:us-west-2:__ACCOUNT_ID__:parameter/crowdpass/temporary-demo/rate-limit-secret"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD",
          "curl",
          "--fail",
          "--silent",
          "--show-error",
          "--max-time",
          "2",
          "http://127.0.0.1:8080/readyz"
        ],
        "interval": 10,
        "timeout": 3,
        "retries": 5,
        "startPeriod": 30
      },
      "stopTimeout": 40,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/crowdpass/temporary-demo",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "app"
        }
      }
    },
    {
      "name": "redis",
      "image": "redis:8.10.2-alpine",
      "essential": false,
      "cpu": 128,
      "memory": 256,
      "user": "999:1000",
      "readonlyRootFilesystem": false,
      "privileged": false,
      "command": [
        "redis-server",
        "--save",
        "",
        "--appendonly",
        "no",
        "--dir",
        "/tmp"
      ],
      "linuxParameters": {
        "capabilities": {
          "drop": [
            "ALL"
          ]
        },
        "initProcessEnabled": true
      },
      "healthCheck": {
        "command": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "interval": 10,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 5
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/crowdpass/temporary-demo",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "redis"
        }
      }
    }
  ],
  "tags": [
    {
      "key": "Project",
      "value": "CrowdPass"
    },
    {
      "key": "Phase",
      "value": "10C"
    },
    {
      "key": "Environment",
      "value": "temporary-demo"
    }
  ]
}
